# Copy to .env.local and fill in real values for local development.
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser / public — use the publishable key (sb_publishable_…).
# Legacy anon JWT still works until you deactivate it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server and local analytics only. Never prefix with NEXT_PUBLIC_.
# Prefer the new secret key (sb_secret_…) from Settings → API Keys.
# Legacy service_role JWT via SUPABASE_SERVICE_ROLE_KEY still works as fallback.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
